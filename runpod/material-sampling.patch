+    # Probe occupancy separately so a supported black material remains exact.
+    candidates = (sampled == 0).all(dim=-1).nonzero().flatten()
+    if candidates.numel():
+        occupancy = torch.ones_like(attr_volume[:, :1]).contiguous()
+        support_shape = torch.Size([1, 1, *grid_size.tolist()])
+
+        def supported(points):
+            grid = ((points - aabb[0]) / voxel_size).reshape(1, -1, 3)
+            return grid_sample_3d(occupancy, sample_coords, shape=support_shape,
